# Gemini (used for STT + extraction)
GEMINI_API_KEY=

# Telegram Bot API (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional: a secret token registered with setWebhook for header validation
TELEGRAM_WEBHOOK_SECRET=
# Override only if you run your own Bot API server
# TELEGRAM_API_BASE=https://api.telegram.org

# Backend forwarding
BACKEND_WEBHOOK_URL=
WEBHOOK_SHARED_SECRET=

# Redis (for arq worker)
REDIS_URL=redis://localhost:6379/0
